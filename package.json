    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
